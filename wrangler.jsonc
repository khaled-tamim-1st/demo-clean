{
  "name": "demo-clean",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./artifacts/demo-clean/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
